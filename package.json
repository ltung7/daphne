{
    "name": "daphne",
    "private": true,
    "version": "0.1.12",
    "type": "module",
    "scripts": {
        "dev": "vite dev --port 4800",
        "build": "vite build",
        "preview": "vite preview --port 4800",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write .",
        "test:unit": "vitest",
        "test": "npm run test:unit -- --run",
        "deploy": "vite build && node build.js && gcloud app deploy build/app.yaml --project=ecomsupportapp && npm --no-git-tag-version version patch",
        "redeploy": "gcloud app deploy build/app.yaml --project=ecomsupportapp --no-cache"
    },
    "devDependencies": {
        "@eslint/compat": "2.0.2",
        "@eslint/js": "9.39.2",
        "@faker-js/faker": "^10.6.0",
        "@sveltejs/kit": "2.34",
        "@sveltejs/vite-plugin-svelte": "6.2.4",
        "@types/node": "24",
        "@vitest/browser-playwright": "4.1.0",
        "eslint": "9.39.2",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-svelte": "3.14.0",
        "globals": "17.3.0",
        "prettier": "3.8.1",
        "prettier-plugin-svelte": "3.4.1",
        "svelte": "5.53.13",
        "svelte-check": "4.4.5",
        "typescript": "5.9.3",
        "typescript-eslint": "8.54.0",
        "vite": "7.3.1",
        "vitest": "4.1.0",
        "vitest-browser-svelte": "2.0.2"
    },
    "dependencies": {
        "@google-cloud/bigquery": "8.1.1",
        "@google/generative-ai": "0.24.1",
        "@sveltestrap/sveltestrap": "7.1.0",
        "@types/docusign-esign": "^5.19.9",
        "@types/pdfkit": "^0.17.6",
        "@types/sql-bricks": "2.0.5",
        "@vincjo/datatables": "1.14.10",
        "axios": "1.19.0",
        "chart.js": "4.5.1",
        "dayjs": "1.11.20",
        "docusign-esign": "^10.0.0",
        "firebase": "12.10.0",
        "firebase-admin": "13.7.0",
        "hash-wasm": "^4.12.0",
        "idosell": "0.4.43",
        "jsonwebtoken": "9.0.3",
        "mysql-bricks": "2.0.0",
        "nodemailer": "8.0.7",
        "pdfkit": "^0.19.1",
        "polish-vehicle-registration-certificate-decoder": "^1.0.1",
        "svelte-adapter-appengine": "1.2.0",
        "svelte-file-dropzone": "2.0.9",
        "svelte-flatpickr": "3.3.5",
        "svelte-paginate": "0.1.0",
        "svelte-typeahead": "5.0.2",
        "sveltefire": "0.4.5",
        "transliteration": "^2.6.1",
        "upload-datafiles-comp": "file:../upload-datafiles-comp",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
        "xlsx-js-style": "1.2.0",
        "zod": "^4.4.3"
    },
    "overrides": {
        "@sveltestrap/sveltestrap": {
            "svelte": "5.53.13"
        },
        "svelte-flatpickr": {
            "svelte": "5.53.13"
        },
        "sveltefire": {
            "firebase": "12.10.0",
            "svelte": "5.53.13"
        }
    }
}
